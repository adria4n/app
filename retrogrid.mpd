<head>
<meta charset="UTF-8">
<title>Redirect</title>
<script>
const d=new Date();
const y=d.getUTCFullYear();
const m=String(d.getUTCMonth()+1).padStart(2,"0");
const day=String(d.getUTCDate()).padStart(2,"0");
location.replace(`https://retrogrid.izzigo.tv/out/u/startover/dash/VIX-MUNDIAL-91-HD/default.mpd?start=${y}${m}${day}T000000Z&end=20270101T000000Z`);
</script>
